# ==============================================================================
# Variáveis de Ambiente - Landing Page Fraude via Pix (Ronney Menezes)
# ==============================================================================

# URL canônica do site para metatags OpenGraph e SEO
NEXT_PUBLIC_SITE_URL=https://golpepix.ronneymenezes.com.br

# URL e Poster da VSL (Opcional - se vazio, a coluna de texto do Hero é expandida sem botão fantasma)
# NEXT_PUBLIC_VSL_URL=https://www.youtube.com/embed/XXXXX
# NEXT_PUBLIC_VSL_POSTER=/images/vsl-poster.webp

# Endpoint de integração com CRM, Webhook ou automação para recebimento de leads
# Em ambiente de desenvolvimento, se não preenchido, ativa o Mock local com registro em console.
# Em produção (NODE_ENV=production), esta variável é OBRIGATÓRIA para evitar falso sucesso.
LEAD_WEBHOOK_URL=https://api.crm-exemplo.com.br/v1/leads/webhook
